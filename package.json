{
  "name": "bismillah-social-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "postbuild": "node scripts/package-media-cleanup.mjs",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.typecheck.json",
    "test:browser": "playwright test",
    "test:production-runtime": "node --test tests/production/runtime.test.mjs",
    "test:production-cleanup": "node --experimental-transform-types --test tests/production/cleanup.test.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "secret-scan": "node scripts/secret-scan.mjs",
    "audit": "npm audit --audit-level=low",
    "check": "npm run lint && npm run typecheck && npm test && npm run secret-scan && npm run audit",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:seed": "node scripts/database.mjs seed",
    "db:provision:production": "node scripts/provision-production.mjs",
    "test:db": "node scripts/database.mjs test",
    "test:mariadb": "vitest run --config vitest.mariadb.config.ts",
    "owner:bootstrap": "node scripts/owner-bootstrap.mjs",
    "media:cleanup": "node --experimental-transform-types scripts/media-cleanup.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "argon2": "0.45.1",
    "kysely": "0.29.6",
    "mp4box": "2.4.1",
    "mysql2": "3.24.6",
    "next": "16.4.1",
    "otplib": "13.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "secretlint": "13.0.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "allowScripts": {
    "argon2@0.45.1": true
  }
}
