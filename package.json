{
  "name": "bismillah-social-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.21.0 <25", "npm": ">=11.19.0 <12" },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "secret-scan": "node scripts/secret-scan.mjs",
    "audit": "npm audit --audit-level=low",
    "check": "npm run lint && npm run typecheck && npm test && npm run secret-scan && npm run audit"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "secretlint": "13.0.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
